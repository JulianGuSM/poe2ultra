{
  "name": "poe2ultra",
  "version": "2.0.0",
  "private": true,
  "description": "A clean, tabbed view of Path of Exile 2 build guides on mobalytics.gg",
  "license": "GPL-3.0-or-later",
  "author": "ReSenpai",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "node tools/package-chrome-variants.mjs both",
    "zip:personal": "node tools/package-chrome-variants.mjs personal",
    "zip:store": "node tools/package-chrome-variants.mjs store",
    "zip:raw": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:poe2-terms": "node tools/build-poe2-terms.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-preact": "^1.46.0",
    "preact": "^10.29.8"
  }
}
